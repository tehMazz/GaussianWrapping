#!/bin/bash
#SBATCH --job-name=gw_tnt
#SBATCH --account=IscrC_EditGS
#SBATCH --partition=boost_usr_prod
#SBATCH --qos=normal
#SBATCH --time=12:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gres=gpu:1
#SBATCH --mem=64G
#SBATCH --output=logs/gw_tnt_%x_%j.out
#SBATCH --error=logs/gw_tnt_%x_%j.err

# Usage:
#   sbatch -J gw_tnt_g<SCENES_ID> gaussian_wrapping/slurm/run_tnt <SCENES_ID>
# where <SCENES_ID> is 0, 1, or 2 (predefined 3-way split: 2 scenes / 2 / 2).
# The -J flag sets the job name, which gets baked into the log file name via %x.
# Submit all three in parallel:
#   for g in 0 1; do sbatch -J gw_tnt_g$g gaussian_wrapping/slurm/run_tnt $g; done
#
# Pipeline per scene (via benchmark_tnt_gw_ours.py):
#   train_and_extract_gw_ours.py -> uniform_sampling_eval -> virtual_scan_eval -> legacy TNT eval
# Mesh is extracted as part of train_and_extract; three evaluations follow.



set -euo pipefail

SCENES_ID="${1:-}"
if [[ -z "$SCENES_ID" ]]; then
    echo "ERROR: missing SCENES_ID positional argument (expected 0, 1, or 2)." >&2
    echo "Usage: sbatch $0 <SCENES_ID>" >&2
    exit 1
fi
if [[ "$SCENES_ID" != "0" && "$SCENES_ID" != "1" && "$SCENES_ID" != "2" ]]; then
    echo "ERROR: SCENES_ID must be 0, 1, or 2 (got '$SCENES_ID')." >&2
    exit 1
fi

# --- Modules (must match what was used to build the GW CUDA extensions) ---
module purge
module load profile/deeplrn
module load cuda/12.2
module load gcc/12.2.0

# --- Python env (uv venv) ---
source /leonardo_scratch/fast/IscrC_EditGS/envs/gaussian_wrapping/bin/activate

# --- Env ---
export TORCH_CUDA_ARCH_LIST="8.0"   # A100
export OMP_NUM_THREADS=$SLURM_CPUS_PER_TASK

# --- Paths ---
# GT files (.ply, _COLMAP_SfM.log, _trans.txt, .json) are co-located with the
# data, so DATA_DIR and GT_DIR are the same.
DATA_DIR=/leonardo_work/IscrC_EditGS/datasets/tnt
GT_DIR=/leonardo_work/IscrC_EditGS/datasets/tnt
OUTPUT_DIR=/leonardo_work/IscrC_EditGS/repos/GaussianWrapping/output/tnt

mkdir -p logs "$OUTPUT_DIR"

cd /leonardo_work/IscrC_EditGS/repos/GaussianWrapping

echo "[INFO] Running scene group $SCENES_ID on SLURM job $SLURM_JOB_ID"

# --gpu_device 0 because SLURM gives us GPU 0 inside the job
python gaussian_wrapping/scripts/benchmark_tnt_gw_ours.py \
    --data_dir "$DATA_DIR" \
    --gt_dir "$GT_DIR" \
    --output_dir "$OUTPUT_DIR" \
    --gpu_device 0 \
    --scenes_id "$SCENES_ID"
